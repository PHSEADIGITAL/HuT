{
  "name": "hut-webapp",
  "version": "1.0.0",
  "description": "Hut! - Hotel booking platform for Bonny Island",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "dev:backend": "node src/server.js",
    "dev:mobile": "npm run start --prefix mobile",
    "mobile:android": "npm run android --prefix mobile",
    "mobile:build:android:preview": "npm run build:android:preview --prefix mobile",
    "mobile:build:android:production": "npm run build:android:production --prefix mobile",
    "mobile:submit:android": "npm run submit:android --prefix mobile",
    "dev:all": "concurrently -k -n backend,mobile -c blue,magenta \"npm run dev:backend\" \"npm run dev:mobile\"",
    "setup:mobile": "npm install --prefix mobile",
    "setup:all": "npm install && npm run setup:mobile",
    "test": "node --test",
    "smoke": "node --test test/smoke.test.js"
  },
  "keywords": [
    "hotel",
    "booking",
    "bonny-island",
    "hut"
  ],
  "author": "Hut Platform",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.3.1",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "supertest": "^7.2.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
