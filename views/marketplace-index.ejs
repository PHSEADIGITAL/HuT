<%- include("partials/header", { title: "Marketplace" }) %>
<%- include("partials/marketplace-masthead", {
  categories,
  searchQuery: filters.q,
  searchCategory: filters.category,
  searchLocation: filters.location,
  searchNeighborhood: filters.neighborhood,
  showQuickCategories: false
}) %>

<section class="marketplace-ebay-layout">
  <aside class="card marketplace-filter-sidebar">
    <div class="marketplace-panel-launchers">
      <button
        type="button"
        class="ghost-btn js-panel-toggle marketplace-panel-toggle"
        data-target="marketplaceFiltersPanel"
        aria-controls="marketplaceFiltersPanel"
        aria-expanded="false"
      >
        Filter results
      </button>
      <button
        type="button"
        class="ghost-btn js-panel-toggle marketplace-panel-toggle"
        data-target="marketplaceCategoriesPanel"
        aria-controls="marketplaceCategoriesPanel"
        aria-expanded="false"
      >
        Shop by category
      </button>
    </div>

    <section id="marketplaceFiltersPanel" class="marketplace-collapsible-panel" hidden>
      <h3>Filter results</h3>
      <form class="marketplace-filter-stack" method="GET" action="/marketplace">
        <input type="hidden" name="q" value="<%= filters.q %>" />
        <div class="marketplace-filter-field">
          <label for="category">Category</label>
          <select id="category" name="category">
            <option value="">All categories</option>
            <% categories.forEach((category) => { %>
              <option value="<%= category %>" <%= filters.category === category ? "selected" : "" %>>
                <%= category %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="marketplace-filter-field">
          <label for="condition">Condition</label>
          <select id="condition" name="condition">
            <option value="">All conditions</option>
            <% conditions.forEach((item) => { %>
              <option value="<%= item %>" <%= filters.condition === item ? "selected" : "" %>><%= item %></option>
            <% }) %>
          </select>
        </div>
        <div class="marketplace-filter-field">
          <label for="location">Location</label>
          <select id="location" name="location">
            <option value="">All locations</option>
            <% locationOptions.forEach((item) => { %>
              <option value="<%= item %>" <%= filters.location === item ? "selected" : "" %>><%= item %></option>
            <% }) %>
          </select>
        </div>
        <div class="marketplace-filter-field">
          <label for="neighborhood">Neighborhood</label>
          <select id="neighborhood" name="neighborhood">
            <option value="">All neighborhoods</option>
            <% neighborhoodOptions.forEach((item) => { %>
              <option value="<%= item %>" <%= filters.neighborhood === item ? "selected" : "" %>><%= item %></option>
            <% }) %>
          </select>
        </div>
        <div class="marketplace-filter-field">
          <label for="minPrice">Min price</label>
          <input id="minPrice" name="minPrice" type="number" min="0" value="<%= filters.minPrice %>" />
        </div>
        <div class="marketplace-filter-field">
          <label for="maxPrice">Max price</label>
          <input id="maxPrice" name="maxPrice" type="number" min="0" value="<%= filters.maxPrice %>" />
        </div>
        <div class="marketplace-filter-field">
          <label for="sort">Sort</label>
          <select id="sort" name="sort">
            <option value="newest" <%= filters.sort === "newest" ? "selected" : "" %>>Best Match / Newest</option>
            <option value="price_asc" <%= filters.sort === "price_asc" ? "selected" : "" %>>Price + Shipping: lowest first</option>
            <option value="price_desc" <%= filters.sort === "price_desc" ? "selected" : "" %>>Price + Shipping: highest first</option>
          </select>
        </div>
        <div class="marketplace-filter-field">
          <button type="submit">Apply filters</button>
        </div>
      </form>
    </section>

    <section id="marketplaceCategoriesPanel" class="marketplace-collapsible-panel" hidden>
      <h3>Shop by category</h3>
      <ul class="marketplace-category-list">
        <% categoryCards.forEach((categoryCard) => { %>
          <li>
            <a class="<%= categoryCard.active ? 'active' : '' %>" href="<%= categoryCard.href %>">
              <span><%= categoryCard.name %></span>
              <small><%= categoryCard.listingCount %></small>
            </a>
          </li>
        <% }) %>
      </ul>

      <div class="marketplace-category-strip compact">
        <% categoryCards.forEach((categoryCard) => { %>
          <a class="marketplace-strip-item <%= categoryCard.active ? 'active' : '' %>" href="<%= categoryCard.href %>">
            <img src="<%= categoryCard.imageUrl %>" alt="<%= categoryCard.name %> category" />
            <span><%= categoryCard.name %></span>
          </a>
        <% }) %>
      </div>
    </section>
  </aside>

  <section class="marketplace-results-panel">
    <article class="card marketplace-results-meta">
      <div>
        <h1>Bonny Island Marketplace</h1>
        <p class="muted">
          <strong><%= listings.length %></strong> item<%= listings.length === 1 ? "" : "s" %>
          found.
        </p>
        <% if (currentUser) { %>
          <p class="muted tiny">
            Account type:
            <strong><%= (marketplaceAccountType || "buyer").toUpperCase() %></strong>
          </p>
          <% if (isSellerMarketplaceUser && limitState) { %>
            <p class="muted tiny">
              Listing plan:
              <strong><%= limitState.currentPlan ? limitState.currentPlan.name : "Free Plan" %></strong>
              • Used <strong><%= limitState.used %></strong> / <strong><%= limitState.includedLimitDisplay %></strong>
            </p>
          <% } %>
          <% if (isBuyerMarketplaceUser) { %>
            <p class="muted tiny">
              Contact access:
              <strong>
                <%= contactAccessState && contactAccessState.hasActive
                  ? `Active until ${contactAccessState.expiresAt}`
                  : `Inactive (${formatNaira(marketplaceContactSubscriptionFeeNaira)}/month)` %>
              </strong>
            </p>
          <% } %>
        <% } %>
      </div>
      <% if (currentUser) { %>
        <div class="marketplace-cta">
          <% if (isSellerMarketplaceUser) { %>
            <a class="button-link" href="/marketplace/new">Sell an item</a>
            <a class="ghost-link" href="/marketplace/my-listings">My listings</a>
          <% } %>
          <% if (isBuyerMarketplaceUser) { %>
            <a class="button-link" href="/wallet">Activate buyer tools</a>
          <% } %>
          <a class="ghost-link" href="/wallet">Wallet (<%= formatNaira(walletBalance || 0) %>)</a>
        </div>
      <% } %>
    </article>

    <% if (currentUser && isSellerMarketplaceUser && limitState) { %>
      <article class="card">
        <button
          type="button"
          class="ghost-btn js-panel-toggle marketplace-panel-toggle"
          data-target="sellerPlanUpgradePanel"
          aria-controls="sellerPlanUpgradePanel"
          aria-expanded="false"
        >
          Upgrade listing plans
        </button>
        <section id="sellerPlanUpgradePanel" class="marketplace-collapsible-panel" hidden>
          <h3>Upgrade listing plans</h3>
          <p class="muted">
            Used <strong><%= limitState.used %></strong> of <strong><%= limitState.includedLimitDisplay %></strong>
            listings this month.
          </p>
          <% if (activePlanSubscriptions.length) { %>
            <p class="muted tiny">
              Active plans:
              <%= activePlanSubscriptions.map((item) => item.planName).join(", ") %>
            </p>
          <% } %>

          <div class="marketplace-plan-grid">
            <% marketplacePlans.filter((plan) => plan.id !== "free").forEach((plan) => { %>
              <article class="card">
                <h4><%= plan.name %></h4>
                <p class="market-price"><%= formatNaira(plan.amount) %></p>
                <p class="muted tiny"><%= plan.description %></p>
                <p class="muted tiny">
                  Monthly limit:
                  <strong><%= plan.listingLimit === null ? "Unlimited" : plan.listingLimit %></strong>
                </p>
                <form method="POST" action="/marketplace/plans/purchase">
                  <input type="hidden" name="planId" value="<%= plan.id %>" />
                  <input type="hidden" name="returnTo" value="/marketplace" />
                  <label class="checkbox tiny">
                    <input type="checkbox" name="autoRenew" value="yes" checked />
                    Auto-renew
                  </label>
                  <button type="submit" class="ghost-btn">Buy with wallet</button>
                </form>
              </article>
            <% }) %>
          </div>
        </section>
      </article>
    <% } %>

    <% if (currentUser && isBuyerMarketplaceUser) { %>
      <article class="card">
        <h3>Buyer contact subscription</h3>
        <p class="muted tiny">
          Unlock any seller contact with one active monthly buyer subscription.
        </p>
        <p class="muted tiny">
          Status:
          <strong>
            <%= contactAccessState && contactAccessState.hasActive
              ? `Active until ${contactAccessState.expiresAt}`
              : `Inactive (${formatNaira(marketplaceContactSubscriptionFeeNaira)}/month)` %>
          </strong>
        </p>
        <form class="grid-form compact" method="POST" action="/marketplace/contact-subscription/purchase">
          <input type="hidden" name="returnTo" value="/marketplace" />
          <div class="full">
            <label class="checkbox">
              <input
                type="checkbox"
                name="autoRenew"
                value="yes"
                <%= contactAccessState && contactAccessState.autoRenew ? "checked" : "" %>
              />
              Enable auto-renew
            </label>
          </div>
          <div class="full">
            <button type="submit" class="ghost-btn">
              <%= contactAccessState && contactAccessState.hasActive
                ? "Update contact auto-renew"
                : `Activate contact access (${formatNaira(marketplaceContactSubscriptionFeeNaira)}/month)` %>
            </button>
          </div>
        </form>
      </article>
    <% } %>

    <section class="marketplace-result-list marketplace-vinted-grid">
      <% if (!listings.length) { %>
        <article class="card">
          <h3>No items found</h3>
          <p class="muted">Try adjusting category, condition, or price filters.</p>
        </article>
      <% } %>
      <% listings.forEach((listing) => { %>
        <article class="market-vinted-card">
          <a class="market-vinted-media" href="/marketplace/listings/<%= listing.id %>">
            <img src="<%= listing.primaryImage %>" alt="<%= listing.title %>" />
          </a>
          <div class="market-vinted-body">
            <p class="muted tiny"><%= listing.condition %> • <%= listing.category %></p>
            <h3><a href="/marketplace/listings/<%= listing.id %>"><%= listing.title %></a></h3>
            <p class="market-price">Now <%= formatNaira(listing.price) %></p>
            <p class="price-anchor tiny">
              <span class="anchor-original"><%= formatNaira(calculateAnchoredPrice(listing.price, 0.14)) %></span>
            </p>
            <p class="muted tiny">
              <%= listing.location || "Location not set" %>
              <% if (listing.neighborhood) { %>• <%= listing.neighborhood %><% } %>
            </p>
            <p class="muted tiny">
              Seller:
              <a href="/marketplace/sellers/<%= listing.sellerUserId %>"><%= listing.sellerName %></a>
              • Rating:
              <%= listing.sellerRatingCount ? `${listing.sellerRatingAverage}/5 (${listing.sellerRatingCount})` : "No ratings yet" %>
            </p>
            <p class="muted tiny">
              Contact unlock requires active subscription
              (<%= formatNaira(marketplaceContactSubscriptionFeeNaira) %>/month)
            </p>
            <a class="button-link small full-width" href="/marketplace/listings/<%= listing.id %>">View item</a>
          </div>
        </article>
      <% }) %>
    </section>
  </section>
</section>

<script>
  (function attachMarketplaceNeighborhoodFilter() {
    const locationSelect = document.getElementById("location");
    const neighborhoodSelect = document.getElementById("neighborhood");
    const locationMap = <%- JSON.stringify(locationNeighborhoods || {}) %>;
    if (!locationSelect || !neighborhoodSelect || !locationMap) {
      return;
    }

    const currentNeighborhood = neighborhoodSelect.value;
    function rebuildNeighborhoodOptions() {
      const selectedLocation = locationSelect.value;
      const options = selectedLocation
        ? (locationMap[selectedLocation] || [])
        : Object.values(locationMap).flat();
      const unique = Array.from(new Set(options));
      const previousValue = neighborhoodSelect.value || currentNeighborhood || "";
      neighborhoodSelect.innerHTML = '<option value="">All neighborhoods</option>';
      unique.forEach((item) => {
        const option = document.createElement("option");
        option.value = item;
        option.textContent = item;
        if (item === previousValue) {
          option.selected = true;
        }
        neighborhoodSelect.appendChild(option);
      });
    }

    locationSelect.addEventListener("change", rebuildNeighborhoodOptions);
  })();
</script>

<%- include("partials/footer", { platform }) %>
