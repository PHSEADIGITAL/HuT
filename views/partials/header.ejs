<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title ? `${title} | ${appName}` : appName %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <%
    const hasForcedMarketplaceMode =
      typeof forceMarketplaceMode === "undefined" ? false : Boolean(forceMarketplaceMode);
    const requestedAuthNextPath = typeof authNextPath === "string" ? authNextPath : "";
    const isMarketplaceTheme = Boolean(
      (currentPath && currentPath.startsWith("/marketplace")) || hasForcedMarketplaceMode
    );
    const marketplaceAuthNext = encodeURIComponent(
      requestedAuthNextPath ||
        (currentPath && currentPath.startsWith("/marketplace") ? currentPath : "/marketplace")
    );
  %>
  <body class="<%= isMarketplaceTheme ? 'marketplace-mode' : '' %>">
    <header class="topbar">
      <div class="container topbar-inner">
        <a class="brand" href="/"><%= appName %></a>
        <nav class="nav">
          <a href="/stays">Stays</a>
          <a href="/marketplace">Marketplace</a>
          <% if (currentUser) { %>
            <a href="/wallet">Wallet</a>
          <% } %>
          <% if (currentUser && (currentUser.role === "hotel_admin" || currentUser.role === "platform_admin")) { %>
            <a href="/admin">Hotel Admin</a>
          <% } %>
          <% if (currentUser && currentUser.role === "platform_admin") { %>
            <a href="/admin/owner-dashboard">Owner Dashboard</a>
          <% } %>
          <% if (currentUser && currentUser.role === "platform_admin") { %>
            <a href="/admin/hotels/new">Onboard Hotel</a>
          <% } %>
        </nav>
        <div class="auth-actions">
          <% if (currentUser) { %>
            <span class="muted tiny">Signed in: <strong><%= currentUser.name %></strong> (<%= currentUser.role %>)</span>
            <form method="POST" action="/auth/logout">
              <button type="submit" class="ghost-btn">Logout</button>
            </form>
          <% } else { %>
            <% if (isMarketplaceTheme) { %>
              <a class="ghost-link" href="/auth/login?next=<%= marketplaceAuthNext %>">Sign in</a>
              <a class="button-link small" href="/auth/register?next=<%= marketplaceAuthNext %>">Create account</a>
            <% } else { %>
              <a class="ghost-link" href="/auth/login">Sign in</a>
              <a class="button-link small" href="/auth/register">Create account</a>
            <% } %>
          <% } %>
        </div>
      </div>
    </header>
    <% if (flash && flash.message) { %>
      <section class="container flash <%= flash.type === 'success' ? 'flash-success' : 'flash-error' %>">
        <p><%= flash.message %></p>
      </section>
    <% } %>
    <main class="container">
