<%- include("partials/header", {
  title: marketplaceTheme ? "Marketplace create account" : "Create account",
  forceMarketplaceMode: marketplaceTheme,
  authNextPath: next
}) %>

<% if (marketplaceTheme) { %>
  <%- include("partials/marketplace-masthead", {
    categories: categories || [],
    searchQuery: "",
    searchCategory: "",
    showQuickCategories: false
  }) %>
<% } %>

<section class="hero small <%= marketplaceTheme ? 'marketplace-auth-hero' : '' %>">
  <h1><%= marketplaceTheme ? "Create your HuT Marketplace account" : "Create your HuT customer account" %></h1>
  <p>
    <%= marketplaceTheme
      ? "Choose buyer or seller and continue directly into marketplace."
      : "Sign up once to book, pay, and manage cancellations securely." %>
  </p>
</section>

<section class="card auth-card <%= marketplaceTheme ? 'marketplace-auth-card' : '' %>">
  <form class="grid-form" method="POST" action="/auth/register">
    <input type="hidden" name="next" value="<%= next %>" />

    <div>
      <label for="name">Full name</label>
      <input id="name" name="name" type="text" required />
    </div>

    <div>
      <label for="phone">Phone</label>
      <input id="phone" name="phone" type="tel" required />
    </div>

    <div class="full">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required />
    </div>

    <div class="full">
      <label>Marketplace account type</label>
      <div class="account-type-grid">
        <label class="account-type-option">
          <input type="radio" name="marketplaceAccountType" value="buyer" checked required />
          <strong>Buyer</strong>
          <span class="muted tiny">Unlock seller contacts and shop marketplace items.</span>
        </label>
        <label class="account-type-option">
          <input type="radio" name="marketplaceAccountType" value="seller" required />
          <strong>Seller</strong>
          <span class="muted tiny">Create listings and manage your seller inventory.</span>
        </label>
      </div>
    </div>

    <div>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" minlength="8" required />
    </div>

    <div>
      <label for="confirmPassword">Confirm password</label>
      <input
        id="confirmPassword"
        name="confirmPassword"
        type="password"
        minlength="8"
        required
      />
    </div>

    <div class="full">
      <button type="submit">Create account</button>
    </div>
  </form>
  <p class="muted">
    Already have an account?
    <a href="/auth/login?next=<%= encodeURIComponent(next) %>">Sign in</a>.
  </p>
</section>

<%- include("partials/footer", { platform }) %>
