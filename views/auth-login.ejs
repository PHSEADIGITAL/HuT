<%- include("partials/header", {
  title: marketplaceTheme ? "Marketplace sign in" : "Sign in",
  forceMarketplaceMode: marketplaceTheme,
  authNextPath: next
}) %>

<% if (marketplaceTheme) { %>
  <%- include("partials/marketplace-masthead", {
    categories: categories || [],
    searchQuery: "",
    searchCategory: "",
    showQuickCategories: false
  }) %>
<% } %>

<section class="hero small <%= marketplaceTheme ? 'marketplace-auth-hero' : '' %>">
  <h1><%= marketplaceTheme ? "Sign in to HuT Marketplace" : "Sign in to Hut" %></h1>
  <p>
    <%= marketplaceTheme
      ? "Continue to marketplace buying, seller contact unlocks, and listing tools."
      : "Customers can book/cancel; hotel admins can access hotel dashboards." %>
  </p>
</section>

<section class="card auth-card <%= marketplaceTheme ? 'marketplace-auth-card' : '' %>">
  <form class="grid-form" method="POST" action="/auth/login" data-remember-form="login">
    <input type="hidden" name="next" value="<%= next %>" />

    <div class="full">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required autocomplete="email" />
    </div>

    <div class="full">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" required autocomplete="current-password" />
    </div>

    <div class="full">
      <label class="checkbox">
        <input type="checkbox" name="rememberCredentials" value="yes" data-remember-checkbox />
        Save login credentials on this device for autofill
      </label>
    </div>

    <div class="full">
      <button type="submit">Sign in</button>
    </div>
  </form>
  <p class="muted tiny">
    Forgot password?
    <a href="/auth/forgot-password">Reset with OTP</a>.
  </p>
  <p class="muted">
    No account yet?
    <a href="/auth/register?next=<%= encodeURIComponent(next) %>">Create one here</a>.
  </p>
</section>

<%- include("partials/footer", { platform }) %>
