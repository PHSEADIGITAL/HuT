{
  "expo": {
    "name": "HuT Mobile",
    "slug": "hut-mobile",
    "version": "1.0.0",
    "scheme": "hutmobile",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hut.mobile"
    },
    "android": {
      "package": "com.hut.mobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HuT to access your photos so you can upload listing images.",
          "cameraPermission": "Allow HuT to use your camera to capture listing photos."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
